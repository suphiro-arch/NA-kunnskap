#!/usr/bin/env sh
set -eu

# Run local mojibake check before commit.
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File tools/check-mojibake.ps1 -Root . -StagedOnly
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-mojibake.ps1 -Root . -StagedOnly
else
  echo "ERROR: Neither pwsh nor powershell was found. Cannot run encoding check." >&2
  exit 1
fi

# Windows-aliaset for python kan peke til Store-snarveien; bruk py-launcheren da.
if python --version >/dev/null 2>&1; then
  PY="python"
elif py -3 --version >/dev/null 2>&1; then
  PY="py -3"
else
  echo "ERROR: Neither python nor py was found. Cannot run checks." >&2
  exit 1
fi

$PY tools/check-resource-version-sync.py
$PY tools/check-resource-structure.py --new-only --strict
$PY tools/check-inline-js.py --strict
